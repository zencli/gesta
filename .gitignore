# Build output
/target
# A build directory under a scratch crate is still a build directory. The root-anchored rule
# above let bench/_floor/target into a commit.
**/target/
**/*.rs.bk

# Repository state lives in the project directory
.gesta/
# The name used before the rename, still ignored so an old directory
# in this repository cannot be committed
.zenforge/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Scratch
/tmp/

# Harness output: one record per run, and a run is not source.
bench/harness/runs/

# Working files a session writes and forgets: a patch script, a commit message held in a file, a
# probe. They are named with a leading dot so they sort out of the way, and one of them reached a
# commit anyway because `.gitignore` did not say so.
.fix*.py
.msg*.txt
.pr*.py
.probe*.py
.gate_*.py
.t_*.py
.*.sh

